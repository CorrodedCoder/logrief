{
  "name": "logrief",
  "version": "1.1.0",
  "productName": "logrief",
  "description": "Logrief behavior pack for Minecraft Bedrock",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "adm-zip": "^0.6.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.3"
  },
  "scripts": {
    "build": "node --enable-source-maps scripts/build.mjs",
    "clean": "node -e \"const fs=require('fs');['dist','lib'].forEach((dir)=>fs.rmSync(dir,{recursive:true,force:true}))\"",
    "build:clean": "npm run clean && npm run build",
    "mcaddon": "node --enable-source-maps scripts/build.mjs --package",
    "dev": "node --enable-source-maps scripts/build.mjs --watch",
    "enablemcloopback": "CheckNetIsolation.exe LoopbackExempt -a -p=S-1-15-2-1958404141-86561845-1752920682-3514627264-368642714-62675701-733520436",
    "enablemcpreviewloopback": "CheckNetIsolation.exe LoopbackExempt -a -p=S-1-15-2-424268864-5579737-879501358-346833251-474568803-887069379-4040235476"
  },
  "dependencies": {
    "@minecraft/server": "^2.1.0",
    "@minecraft/server-ui": "^2.0.0",
    "@minecraft/vanilla-data": "^1.20.60"
  }
}
